# 复制为 .env 并填入你自己的值 / Copy to .env and fill in your own values.
# .env 已被 .gitignore 忽略，绝不要提交真实密钥。
# .env is gitignored — never commit real secrets.

# --- SearXNG ---
# 随机生成一个：openssl rand -hex 32
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- LLM (OpenAI 兼容端点, 用于 web_ask 的 RAG 总结) ---
# LLM (any OpenAI-compatible endpoint, powers web_ask RAG). 可换 OpenAI / Ollama / 其它。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- FlareSolverr (可选, 反爬/Cloudflare; 默认不用) ---
# FlareSolverr (optional, anti-bot/Cloudflare; off by default)
FLARESOLVERR_URL=http://localhost:8191

# --- 火山豆包 Web 搜索 (可选, SearXNG 的 doubao 自定义引擎用) ---
# Volcengine Doubao web search (optional, for the SearXNG `doubao` engine)
WEB_SEARCH_API_KEY=

# --- 项目私有出站代理 (可选; scripts/agent-search-711-proxy.sh 用) ---
# Project-scoped outbound proxy (optional; used by scripts/agent-search-711-proxy.sh).
# 设了 AGENT_SEARCH_OUTBOUND_PROXY 指向 :17110, run.sh 会自动拉起本地 sing-box 代理。
# If set to the :17110 endpoint, run.sh auto-starts the local sing-box proxy.
AGENT_SEARCH_OUTBOUND_PROXY=
# 轮换代理的 gen(生成)API 端点 —— 私有基建, 填你自己的; 带 &/? 时用单引号包住。
# Rotating-proxy gen (generate) API endpoint — your own; single-quote it if it has &/?.
AGENT_SEARCH_711_GEN_URL=
# 上游代理 host:port(可选, 默认 127.0.0.1:7890) / upstream proxy (default 127.0.0.1:7890)
AGENT_SEARCH_711_UPSTREAM_PROXY=
